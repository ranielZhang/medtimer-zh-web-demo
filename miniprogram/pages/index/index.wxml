<view class="app" style="padding-top: {{statusBarHeight}}px">
  <view class="topbar">
    <view class="back" wx:if="{{screen !== 'main'}}" bindtap="backToMain">‹</view>
    <text class="title">{{screen === 'editor' ? (editingId ? formMedicine.name : '添加药品') : screen === 'reminder' ? (editingReminderId ? '编辑提醒' : '添加提醒') : screen === 'manual' ? '补记服药' : tab === 'overview' ? '主页 · ' + monthTitle : tab === 'medicines' ? '药品' : '分析'}}</text>
    <view class="more" bindtap="openMenu">⋮</view>
  </view>

  <scroll-view scroll-y class="content" wx:if="{{screen === 'main'}}">
    <view wx:if="{{tab === 'overview'}}" class="overview">
      <view class="week-strip"><view class="week-arrow" bindtap="previousWeek">‹</view><view class="week-days"><view wx:for="{{weekDates}}" wx:key="day" class="week-day {{item.selected ? 'selected' : ''}}" data-day="{{item.day}}" bindtap="selectDay"><text class="week-label">{{item.label}}</text><text class="week-number">{{item.number}}</text></view></view><view class="week-arrow" bindtap="nextWeek">›</view></view>
      <view class="filter-row"><view wx:for="{{filters}}" wx:key="value" class="filter-chip {{filter === item.value ? 'on' : ''}}" data-filter="{{item.value}}" bindtap="selectFilter">{{item.label}}</view></view>
      <view class="selection-actions"><text>☑</text><text>⊗</text><text>♧</text><text>◷</text></view>
      <view class="timeline" wx:if="{{displayRows.length}}"><view wx:for="{{displayRows}}" wx:key="key" class="event-row"><view class="rail"><view class="state-circle {{item.status}}" data-key="{{item.key}}" bindtap="tapStatus">{{item.icon}}</view><view class="rail-line"></view></view><view class="event-card" data-id="{{item.medicineId}}" bindtap="openMedicine"><view class="event-text"><text class="event-time">▣ {{item.time}}{{item.snoozeText}}</text><text class="event-name">{{item.name}}</text><text class="event-dose">{{item.amount}} {{item.unit}} · {{item.statusText}}</text></view><view class="swatch" style="background:{{item.color}}">{{item.medicineIcon}}</view></view></view></view>
      <view class="empty" wx:else>这一天没有符合规则的提醒</view>
      <view class="info-line">点左侧状态图标处理提醒；点药品卡片查看药品与规则。</view>
    </view>

    <view wx:elif="{{tab === 'medicines'}}" class="medicine-list"><view wx:for="{{medicineCards}}" wx:key="id" class="medicine-card" data-id="{{item.id}}" bindtap="openMedicine"><view class="medicine-top"><view class="swatch large" style="background:{{item.color}}">{{item.icon}}</view><view class="medicine-main"><text class="medicine-name">{{item.name}}</text><text class="medicine-stock">库存 {{item.stock}} {{item.unit}} {{item.low ? '⚠' : ''}}</text><text class="medicine-reminders">{{item.reminderCount}} 条提醒 · {{item.times}}</text></view><text class="drag-handle">⠿</text></view><view class="tag-row"><text wx:for="{{item.tags}}" wx:key="*this" class="tag">{{item}}</text></view></view><view class="empty" wx:if="{{!medicineCards.length}}">暂无药品，点击下方添加</view></view>

    <view wx:else class="analysis"><view class="analysis-switch"><view class="switch {{analysisMode === 'chart' ? 'active' : ''}}" data-mode="chart" bindtap="switchAnalysis">▥</view><view class="switch {{analysisMode === 'table' ? 'active' : ''}}" data-mode="table" bindtap="switchAnalysis">▦</view><view class="switch {{analysisMode === 'calendar' ? 'active' : ''}}" data-mode="calendar" bindtap="switchAnalysis">▣</view><picker wx:if="{{analysisMode === 'chart'}}" class="range-picker" range="{{rangeOptions}}" value="{{rangeIndex}}" bindchange="changeRange"><view>{{rangeOptions[rangeIndex]}} ⌄</view></picker></view>
      <view wx:if="{{analysisMode === 'chart'}}"><view class="chart-card"><view class="chart-bars"><view wx:for="{{chartBars}}" wx:key="day" class="chart-col"><view class="bar-stack"><view class="bar-skipped" style="height:{{item.skippedHeight}}%"></view><view class="bar-taken" style="height:{{item.takenHeight}}%"></view></view><text>{{item.label}}</text></view></view><view class="legend"><text>● 已服用</text><text>● 已跳过</text></view></view><view class="summary-row"><view class="summary-card"><text>最近 {{rangeDays}} 天</text><text class="summary-big">{{takenRate}}%</text><text>已服用 {{takenCount}} · 已跳过 {{skippedCount}}</text></view><view class="summary-card"><text>总记录</text><text class="summary-big">{{totalEvents}}</text><text>每条来自一次用药事件</text></view></view></view>
      <view wx:elif="{{analysisMode === 'table'}}" class="table-card"><view class="table-head"><text>处理时间</text><text>药品</text><text>状态</text></view><view wx:for="{{historyRows}}" wx:key="key" class="table-row"><text>{{item.timeLabel}}</text><text>{{item.name}}</text><text>{{item.statusText}}</text></view><view class="empty" wx:if="{{!historyRows.length}}">还没有已处理的事件</view></view>
      <view wx:else class="calendar-card"><view class="calendar-head"><text bindtap="previousMonth">‹</text><text>{{calendarTitle}}</text><text bindtap="nextMonth">›</text></view><view class="calendar-grid"><text wx:for="{{weekdayLabels}}" wx:key="*this" class="calendar-weekday">{{item}}</text><view wx:for="{{calendarCells}}" wx:key="day" class="calendar-cell {{item.current ? '' : 'outside'}} {{item.selected ? 'chosen' : ''}} {{item.hasEvent ? 'has-event' : ''}}" data-day="{{item.day}}" bindtap="selectCalendarDay">{{item.number}}</view></view><view class="calendar-events"><text class="calendar-date">{{selectedDay}}</text><view wx:for="{{calendarEventRows}}" wx:key="key" class="calendar-event">{{item.icon}} {{item.time}}　{{item.name}} · {{item.statusText}}</view><text wx:if="{{!calendarEventRows.length}}">当天没有提醒事件</text></view></view>
    </view>
    <view class="scroll-pad"></view>
  </scroll-view>

  <scroll-view scroll-y class="content editor-content" wx:elif="{{screen === 'editor'}}"><view class="editor-card"><view class="editor-heading"><view class="swatch circle" style="background:{{formMedicine.color}}">{{formMedicine.icon}}</view><view class="field grow"><text>药品名称</text><input value="{{formMedicine.name}}" data-field="name" bindinput="medicineInput" placeholder="填写药品名称"/></view></view><view class="editor-tools"><text>⚙</text><text>▤</text><text>◇</text><text data-focus="stock" bindtap="focusEditorField">□</text><text>▦</text></view></view><view class="subhead">药品信息</view><view class="editor-card"><view class="field"><text>备注</text><input value="{{formMedicine.notes}}" data-field="notes" bindinput="medicineInput" placeholder="按已有用药方案填写"/></view><view class="field"><text>标签（逗号分隔）</text><input value="{{formMedicine.tagText}}" data-field="tagText" bindinput="medicineInput" placeholder="例如：维生素,日常"/></view><view class="two-fields"><view class="field"><text>库存</text><input id="stock-field" type="digit" value="{{formMedicine.stock}}" data-field="stock" bindinput="medicineInput"/></view><view class="field"><text>单位</text><input value="{{formMedicine.unit}}" data-field="unit" bindinput="medicineInput"/></view></view><view class="field"><text>低库存提醒阈值</text><input type="digit" value="{{formMedicine.threshold}}" data-field="threshold" bindinput="medicineInput"/></view></view><view class="subhead">提醒</view><view wx:for="{{editorReminders}}" wx:key="id" class="reminder-card" data-id="{{item.id}}" bindtap="openReminder"><view class="reminder-line"><text class="reminder-icon">▣</text><view><text class="reminder-time">{{item.time}}</text><text class="reminder-dose">{{item.amount}} {{formMedicine.unit}} · {{item.summary}}</text></view></view><view class="advanced-pill">⚙　高级设置　›</view></view><button class="fab inline" bindtap="addReminder">⊕　添加提醒</button><view class="editor-actions"><button class="save" bindtap="saveMedicine">保存药品</button><button class="danger" wx:if="{{editingId}}" bindtap="deleteMedicine">删除药品</button></view><view class="scroll-pad"></view></scroll-view>

  <scroll-view scroll-y class="content editor-content" wx:elif="{{screen === 'reminder'}}"><view class="editor-card"><view class="field"><text>提醒类型</text><picker range="{{reminderTypes}}" value="{{reminderTypeIndex}}" bindchange="changeReminderType"><view class="picker-value">{{reminderTypes[reminderTypeIndex]}}　⌄</view></picker></view><view class="field"><text>提醒时间</text><picker mode="time" value="{{formReminder.time}}" bindchange="changeReminderTime"><view class="picker-value">{{formReminder.time}}　⌄</view></picker></view><view class="field"><text>单次用量（{{formMedicine.unit}}）</text><input type="digit" value="{{formReminder.amount}}" data-field="amount" bindinput="reminderInput"/></view><view wx:if="{{reminderTypeIndex === 0}}"><text class="field-label">每周提醒日</text><view class="weekday-choices"><view wx:for="{{reminderWeekdays}}" wx:key="value" class="weekday-choice {{item.selected ? 'selected' : ''}}" data-day="{{item.value}}" bindtap="toggleWeekday">{{item.label}}</view></view></view><view wx:else><view class="field"><text>周期起始日</text><picker mode="date" value="{{formReminder.cycleStart}}" bindchange="changeCycleStart"><view class="picker-value">{{formReminder.cycleStart}}　⌄</view></picker></view><view class="two-fields"><view class="field"><text>连续服用天数</text><input type="number" value="{{formReminder.activeDays}}" data-field="activeDays" bindinput="reminderInput"/></view><view class="field"><text>暂停天数</text><input type="number" value="{{formReminder.pauseDays}}" data-field="pauseDays" bindinput="reminderInput"/></view></view></view><view class="toggle-row" bindtap="toggleReminderActive"><text>启用提醒</text><switch checked="{{formReminder.active}}" color="#566a9c" disabled/></view></view><view class="notice">网页与小程序演示只在打开期间计算到点状态；后台系统通知需要另行接入订阅消息服务。</view><view class="editor-actions"><button class="save" bindtap="saveReminder">保存提醒</button><button class="danger" wx:if="{{editingReminderId}}" bindtap="deleteReminder">删除提醒</button></view></scroll-view>

  <scroll-view scroll-y class="content editor-content" wx:else><view class="editor-card"><view class="field"><text>药品</text><picker range="{{medicineNames}}" value="{{manualMedicineIndex}}" bindchange="manualSelectMedicine"><view class="picker-value">{{medicineNames[manualMedicineIndex]}}　⌄</view></picker></view><view class="field"><text>实际服用数量</text><input type="digit" value="{{manualAmount}}" bindinput="manualAmountInput"/></view><view class="notice">补记会创建独立的已服用事件，并扣减相应库存。</view></view><view class="editor-actions"><button class="save" bindtap="saveManualDose">记录这次服药</button></view></scroll-view>

  <view class="fab" wx:if="{{screen === 'main' && tab === 'overview'}}" bindtap="openManual">▰　补记服药</view>
  <view class="fab" wx:if="{{screen === 'main' && tab === 'medicines'}}" bindtap="addMedicine">⊕　添加药品</view>
  <view class="tabbar" wx:if="{{screen === 'main'}}"><view class="tab {{tab === 'overview' ? 'current' : ''}}" data-tab="overview" bindtap="switchTab"><text>▣</text><text>主页</text></view><view class="tab {{tab === 'medicines' ? 'current' : ''}}" data-tab="medicines" bindtap="switchTab"><text>◕</text><text>药品</text></view><view class="tab {{tab === 'analysis' ? 'current' : ''}}" data-tab="analysis" bindtap="switchTab"><text>▥</text><text>分析</text></view></view>
</view>
